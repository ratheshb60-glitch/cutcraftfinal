# GEMINI_API_KEY: Optional Gemini API key if AI features are added later.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Hosted URL of the application.
APP_URL="MY_APP_URL"

# CUTCRAFT_SECRET: Pepper secret for C SHA-256 password hashing.
CUTCRAFT_SECRET="CHANGE_ME_IN_PRODUCTION"

# CUTCRAFT_C_PORT: Internal port for compiled C HTTP server.
CUTCRAFT_C_PORT="18088"
